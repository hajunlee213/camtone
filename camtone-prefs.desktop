[Desktop Entry]
Name=CamTone Settings
Name[ko]=CamTone 설정
Comment=Configure brightness and color temperature from the webcam sensor
Comment[ko]=웹캠 센서 기반 화면 밝기와 색온도 설정
Exec=gnome-extensions prefs camtone@hajunlee213.github.io
Icon=night-light-symbolic
Terminal=false
Type=Application
Categories=GNOME;GTK;Settings;HardwareSettings;
Keywords=webcam;ambient;light;brightness;color;temperature;nightlight;als;웹캠;밝기;색온도;야간모드;
StartupNotify=true
