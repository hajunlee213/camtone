[Unit]
Description=CamTone: adaptive brightness and color temperature
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=io.github.hajunlee213.CamTone
ExecStart=%h/.local/bin/camtone
Restart=on-failure
RestartSec=5s
